{
  "name": "@formdash/types",
  "version": "0.1.0",
  "description": "Shared TypeScript definitions and Zod schemas for Formdash",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "emdash",
    "forms",
    "types",
    "zod"
  ],
  "author": "Swapnil Maheshwari",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  }
}
